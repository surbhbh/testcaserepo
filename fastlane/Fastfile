default_platform(:ios)

platform :ios do
  desc "Build for testing"
  lane :build_for_testing do
    scan(
      workspace: "MyApp.xcworkspace",
      scheme: "MyApp",
      clean: true,
      build_for_testing: true,
      derived_data_path: "DerivedData",
      destination: "platform=iOS Simulator,name=iPhone 15,OS=16.4",  # Fixed destination format
      xcargs: "ONLY_ACTIVE_ARCH=YES"
    )
  end

  desc "Run all tests"
  lane :test do
    scan(
      workspace: "MyApp.xcworkspace",
      scheme: "MyApp",
      clean: true,
      code_coverage: true,
      derived_data_path: "DerivedData",
      destination: "platform=iOS Simulator,name=iPhone 15,OS=16.4"  # Fixed destination format
    )
  end

  desc "Run integration tests"
  lane :run_integration_testing do
    scan(
      workspace: "MyApp.xcworkspace",
      scheme: "MyApp",
      clean: false,
      code_coverage: true,
      derived_data_path: "DerivedData",
      destination: "platform=iOS Simulator,name=iPhone 15,OS=16.4",  # Fixed destination format
      test_without_building: true,
      only_testing: [
        "MyAppIntegrationTests"  # Adjust this to your actual integration test target name
      ]
    )
  end
end
